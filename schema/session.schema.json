{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kacyluker.com/astronomy/schema/session.schema.json",
  "title": "Observing session",
  "description": "One night of observing, transcribed from a paper log sheet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "site", "observers", "observations"],
  "properties": {
    "id": {
      "description": "Unique slug; matches the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "program": {
      "description": "Observing program, e.g. Messier, Herschel 400.",
      "type": ["string", "null"]
    },
    "date": { "description": "Local date the session started.", "type": "string", "format": "date" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "lat": {
          "anyOf": [
            { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            { "$ref": "#/$defs/na" }
          ]
        },
        "lon": {
          "anyOf": [
            { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
            { "$ref": "#/$defs/na" }
          ]
        }
      }
    },
    "sky": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sqm": {
          "anyOf": [
            {
              "description": "Sky Quality Meter reading, mag/arcsec^2.",
              "type": ["number", "null"]
            },
            { "$ref": "#/$defs/na" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "observers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "notebook": {
      "description": "Id of the notebook the session is written in (data/notebooks/<id>.json).",
      "type": "string"
    },
    "pages": {
      "description": "Notebook page numbers the session covers.",
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "notes": { "type": ["string", "null"] },
    "header_box": {
      "description": "Where the NEW SESSION block is: its notebook page and box. Each observation's sketch image is cut from this and its own box.",
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "box"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "box": { "$ref": "#/$defs/box" }
      }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "box": {
      "description": "[x, y, width, height] as fractions of the page image.",
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": ["string", "null"] },
        "aperture_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "focal_length_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "f_ratio": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "scale": {
      "anyOf": [
        {
          "description": "Seeing/transparency on the sheet's I-V scale, stored as 1-5.",
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        { "$ref": "#/$defs/na" }
      ]
    },
    "time": {
      "anyOf": [
        { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        { "$ref": "#/$defs/na" }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id"],
      "properties": {
        "catalog_id": {
          "description": "The designation written on the sheet, e.g. M51.",
          "type": "string"
        },
        "aka": { "description": "Common name, e.g. Whirlpool Galaxy.", "type": ["string", "null"] },
        "ids": {
          "description": "Every known designation, including cross-catalog IDs.",
          "type": "array",
          "items": { "type": "string" }
        },
        "page": {
          "description": "Notebook page number the entry is on.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "local_time": { "$ref": "#/$defs/time" },
        "ut": { "$ref": "#/$defs/time" },
        "seeing": { "$ref": "#/$defs/scale" },
        "transparency": { "$ref": "#/$defs/scale" },
        "scope": {
          "description": "Overrides the session scope when a different one was used.",
          "$ref": "#/$defs/scope"
        },
        "eyepiece": { "type": ["string", "null"] },
        "magnification": {
          "description": "The MAG half of EP/MAG, e.g. 92 for 92x.",
          "anyOf": [
            { "type": ["number", "null"], "exclusiveMinimum": 0 },
            { "$ref": "#/$defs/na" }
          ]
        },
        "filter": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "box": {
          "description": "Where the entry (fields, sketch circle and description) is on its page.",
          "$ref": "#/$defs/box"
        },
        "favorite": {
          "description": "Kacy's favorite observation of this object; at most one per object (scripts/favorite.mjs).",
          "type": "boolean"
        }
      }
    },
    "na": {
      "description": "Written as N/A on the sheet: the field doesn't apply. A blank field is null (or left out) instead, and counts as a to-do.",
      "const": "N/A"
    }
  }
}
