{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog info for observed objects",
  "description": "Generated by scripts/enrich-ids.mjs and the import from OpenNGC; don't edit by hand. Keyed by each object's first designation.",
  "type": "object",
  "required": ["source", "license", "objects"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string" },
    "license": { "type": "string" },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ids", "type"],
        "additionalProperties": false,
        "properties": {
          "ids": { "description": "Every designation, Messier first.", "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "name": { "description": "Common name.", "type": ["string", "null"] },
          "names": { "description": "All common names, when there are several.", "type": "array", "items": { "type": "string" } },
          "type": { "type": "string" },
          "constellation": { "type": ["string", "null"] },
          "magnitude": { "type": ["number", "null"] },
          "size": { "description": "Apparent size in arcminutes.", "type": ["string", "null"] },
          "ra": { "type": ["string", "null"] },
          "dec": { "type": ["string", "null"] }
        }
      }
    }
  }
}
