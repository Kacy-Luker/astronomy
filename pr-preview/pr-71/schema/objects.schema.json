{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog info for observed objects",
  "description": "Generated by scripts/enrich-ids.mjs and the import from the catalog sources (scripts/lib/catalogs/); don't edit by hand. Keyed by each object's first designation.",
  "type": "object",
  "required": ["sources", "objects"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "description": "The catalog sources the objects came from, credited on the site.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "license"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "url": { "type": "string" },
          "license": { "type": ["string", "null"] }
        }
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ids", "type"],
        "additionalProperties": false,
        "properties": {
          "ids": { "description": "Every designation, Messier first.", "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "source": { "description": "The catalog source it came from (one of sources).", "type": "string" },
          "name": { "description": "Common name.", "type": ["string", "null"] },
          "names": { "description": "All common names, when there are several.", "type": "array", "items": { "type": "string" } },
          "type": { "type": "string" },
          "constellation": { "type": ["string", "null"] },
          "magnitude": { "type": ["number", "null"] },
          "size": { "description": "Apparent size in arcminutes.", "type": ["string", "null"] },
          "ra": { "type": ["string", "null"] },
          "dec": { "type": ["string", "null"] }
        }
      }
    }
  }
}
